---
interface Props {
    current?: string;
}

let { current } = Astro.props;
if (!current) {
    current = "home";
}

let base = import.meta.env.BASE_URL;

if (!base.endsWith('/')) {
    base += '/';
}

const links = [
    { href: `${base}`, label: "Home", id: "home" },
    { href: `${base}contact`, label: "Contact", id: "contact" },
    { href: `${base}equipment`, label: "Equipment", id: "equipment" },
    { href: `${base}neighbours`, label: "Neighbours", id: "neighbours" },
    { href: `${base}olfeed`, label: "OLN feed", id: "olfeed" },
];
---

<header>
    <h1>kier(.)ov(h)nik{(current != "home" && (<span>/{current}</span>))}</h1>
    <nav>
        <ul>
            {
                links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class={link.id.startsWith(current) ? "selected" : ""}
                            >
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>
</header>
<style is:global>
    header {
        padding: 5px 0;
        margin: 10px auto;
        width: 90vw;
    }

    @media (prefers-contrast: more) {
        header {
            color: #fff;
        }
    }

    header h1 {
        font-size: 24px;
        margin: 0;
    }

    nav ul {
        width: 90vw;
        list-style-type: none;
        margin: 0 auto;
        padding: 0;
        overflow: hidden;
        color: #e8def8;
    }

    nav li {
        float: left;
    }

    nav a {
        color: white;
        text-decoration: none;
        margin-right: 10px;
        font-weight: normal;
    }
    
    nav a.selected {
        text-decoration: underline;
    }

    nav a:hover {
        text-decoration: underline;
    }

    @media (prefers-color-scheme: light) {
        nav a {
            color: #5c327c;
        }

        @media (min-width: 600px) {
            header {
                border-right: #5c327c solid 1px;
            }
        }
    }

    @media (min-width: 1000px) {
        body {
            overflow-x: hidden;
        }
        
        header {
            position: fixed;
            left: 0;
            right: 0;
            width: 250px;
            height: 100vh;
            margin: 0 10px;
            list-style: none;
            border-right: #282828 solid 1px;
            padding: 0px;
        }

        .main {
            width: calc(100% - 250px);
            margin-left: 250px;
            padding-left: 10px;
            border-top: none;
        }

        footer {
            margin-left: 250px !important;
            width: calc(100% - 250px);
        }

        h2 {
            font-size: 24px;
        }

        nav ul {
            width: 100%;
            list-style-type: circle;
            padding: 20px;
            overflow: auto;
            margin: 0px;
            font-size: 16px;
        }

        nav li {
            float: none;
        }
    }
</style>
